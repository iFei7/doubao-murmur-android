<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/apk/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      Foreground service permissions are only used by the degraded path where the IME window is
      hidden (e.g. the user pressed HOME while talking) and capture has to continue briefly.
      The primary path captures audio while the input view is visible and needs no service.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!--
      Android 11+ package visibility: the login screen's Custom Tabs route has to discover the
      browser that implements the Custom Tabs protocol before it can bind to it.
    -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <!--
      A microphone is not mandatory: some devices ship an external USB or Bluetooth microphone
      that is probed at runtime (see MicProbe in :audio).
    -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher_tv"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MurmurTv">

        <!-- Required by Macrobenchmark (:benchmark) so that release builds can be profiled. -->
        <profileable android:shell="true" />

        <activity
            android:name="com.doubao.murmur.tv.app.MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.doubao.murmur.tv.app.login.LoginActivity"
            android:exported="false" />

        <!--
          Declaring our own CustomTabsService is the documented prerequisite for the Custom Tab
          session-data sharing: a tab launched with a session bound through this app stores its
          cookies/localStorage in a profile backed by this app's data directory, so the login
          screen can collect the credentials (see LoginActivity / LoginCustomTabsService).
          The service itself is empty. exported=true is required - the browser binds to this
          service to validate the association - and the browser is the only legitimate caller.
        -->
        <service
            android:name="com.doubao.murmur.tv.app.login.LoginCustomTabsService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="android.support.customtabs.action.CustomTabsService" />
            </intent-filter>
        </service>

        <activity
            android:name="com.doubao.murmur.tv.app.permission.MicPermissionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:theme="@style/Theme.MurmurTv.Translucent" />

    </application>

</manifest>
