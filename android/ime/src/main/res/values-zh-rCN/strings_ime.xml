<?xml version="1.0" encoding="utf-8"?>
<!--
  中文翻译（与 values/strings_ime.xml 的 key 集合完全一致）。

  :app 在打包时会用自己 values-zh-rCN/strings.xml 里的同名 key 覆盖本文件 —— 应用模块的
  资源优先级高于库模块。保留这份副本是为了让 :ime 在不依赖 :app 的情况下仍然可读（例如
  单独跑 UI 预览或截图测试）。
-->
<resources>

    <!-- 键盘标识（AndroidManifest.xml 与 res/xml/method.xml 引用） -->
