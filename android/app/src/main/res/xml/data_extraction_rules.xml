<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (android:dataExtractionRules). Both cloud backup and device transfer must exclude
  the encrypted credential store: the Keystore master key never leaves the device, and a copied
  session cookie blob would be a credential leak.
-->
<data-extraction-rules>

    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="murmur_secure_credentials.xml" />
        <exclude
            domain="sharedpref"
            path="." />
        <exclude
            domain="file"
            path="datastore/" />
    </cloud-backup>

    <device-transfer>
        <exclude
            domain="sharedpref"
            path="murmur_secure_credentials.xml" />
        <exclude
            domain="sharedpref"
            path="." />
        <exclude
            domain="file"
            path="datastore/" />
    </device-transfer>

</data-extraction-rules>
